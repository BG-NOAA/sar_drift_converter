netcdf SAR_drift_data {
dimensions:
	time = UNLIMITED ; // (0 currently)
	y = 361 ;
	x = 361 ;
variables:
	float sea_ice_speed(time, y, x) ;
		sea_ice_speed:long_name = "Sea ice speed" ;
		sea_ice_speed:standard_name = "sea_ice_speed" ;
		sea_ice_speed:ioos_category = "sea-ice" ;
		sea_ice_speed:units = "m s-1" ;
		sea_ice_speed:grid_mapping = "spatial_ref" ;
	float sea_ice_x_displacement(time, y, x) ;
		sea_ice_x_displacement:_FillValue = NaNf ;
		sea_ice_x_displacement:long_name = "u-velocity component" ;
		sea_ice_x_displacement:standard_name = "movement_in_x_direction" ;
		sea_ice_x_displacement:ioos_category = "sea-ice" ;
		sea_ice_x_displacement:units = "m s-1" ;
		sea_ice_x_displacement:grid_mapping = "spatial_ref" ;
		sea_ice_x_displacement:comment = "x values are the centers of the grid cells" ;
	float sea_ice_y_displacement(time, y, x) ;
		sea_ice_y_displacement:_FillValue = NaNf ;
		sea_ice_y_displacement:long_name = "v-velocity component" ;
		sea_ice_y_displacement:standard_name = "movement_in_y_direction" ;
		sea_ice_y_displacement:ioos_category = "sea-ice" ;
		sea_ice_y_displacement:units = "m s -1" ;
		sea_ice_y_displacement:grid_mapping = "spatial_ref" ;
	float direction_of_sea_ice_displacement(time, y, x) ;
		direction_of_sea_ice_displacement:long_name = "Direction of the vector change in geospatial position of an object that has moved over time" ;
		direction_of_sea_ice_displacement:standard_name = "direction_of_sea_ice_displacement" ;
		direction_of_sea_ice_displacement:ioos_category = "SAR daily sea-ice drift" ;
		direction_of_sea_ice_displacement:units = "degrees" ;
		direction_of_sea_ice_displacement:grid_mapping = "spatial_ref" ;
	short outlier_category(time, y, x) ;
		outlier_category:long_name = "Outlier category code" ;
		outlier_category:standard_name = "status_flag" ;
		outlier_category:ioos_category = "quality_flag" ;
		outlier_category:units = "1" ;
		outlier_category:flag_values = 0s, 1s, 10s, 11s, 20s, 21s, 30s, 31s, 40s, 41s, 50s, 51s, 60s, 61s, 70s, 71s ;
		outlier_category:comment = "Codes are displayed conceptually as 00, 01, 10, 11, 20, 21, 30, 31, 40, 41, 50, 51, 60, 61, 70 71." ;
		outlier_category:flag_meanings = "None_under None_above Distance_under Distance_above Bearing_under Bearing_above Mahalanobis_under Mahalanobis_above Distance_bearing_under Distance_bearing_above Mahalanobis_distance_under Mahalanobis_distance_above Mahalanobis_bearing_under Mahalanobis_bearing_above Mahalanobis_distance_bearing_under Mahalanobis_distance_bearing_above" ;
		outlier_category:grid_mapping = "spatial_ref" ;
	short bearing_error(time, y, x) ;
		bearing_error:long_name = "Possible bearing error flag" ;
		bearing_error:standard_name = "status_flag" ;
		bearing_error:ioos_category = "quality_flag" ;
		bearing_error:units = "1" ;
		bearing_error:_FillValue = -9s ;
		bearing_error:flag_values = 0s, 1s ;
		bearing_error:flag_meanings = "valid invalid" ;
		bearing_error:comment = "1 if Bear_deg == 0 or Speed_kmdy <= 0, 0 otherwise." ;
		bearing_error:grid_mapping = "spatial_ref" ;
	short speed_error(time, y, x) ;
		speed_error:long_name = "Possible speed error flag" ;
		speed_error:standard_name = "status_flag" ;
		speed_error:ioos_category = "quality_flag" ;
		speed_error:units = "1" ;
		speed_error:_FillValue = -9s ;
		speed_error:flag_values = 0s, 1s ;
		speed_error:flag_meanings = "valid invalid" ;
		speed_error:comment = "1 if Speed_kmdy >= 35.0 (75km file) or >= 25.0 (50km file), 0 otherwise." ;
		speed_error:grid_mapping = "spatial_ref" ;
	short measurement_error(time, y, x) ;
		measurement_error:long_name = "Possible measurement error flag" ;
		measurement_error:standard_name = "status_flag" ;
		measurement_error:ioos_category = "quality_flag" ;
		measurement_error:units = "1" ;
		measurement_error:_FillValue = -9s ;
		measurement_error:flag_values = 0s, 1s ;
		measurement_error:flag_meanings = "valid invalid" ;
		measurement_error:comment = "1 if Maxcorr1 > Maxcorr2 (bad correlation match), 0 otherwise." ;
    measurement_error:grid_mapping = "spatial_ref" ;		
	double time(time) ;
		time:standard_name = "time" ;
		time:long_name = "Centered Time" ;
		time:units = "seconds since 1970-01-01 00:00:00 UTC" ;
		time:calendar = "standard" ;
		time:axis = "T" ;
		time:CoordinateAxisType = "Time" ;
		time:comment = "This is the 00Z reference time. Note that products are nowcasted to be valid specifically at the time given here." ;
	double x(x) ;
		x:standard_name = "projection_x_coordinate" ;
		x:long_name = "x coordinate of projection" ;
		x:ioos_category = "Location" ;
		x:units = "m" ;
		x:axis = "X" ;
		x:comment = "y values are the centers of the grid cells" ;
	double y(y) ;
		y:standard_name = "projection_y_coordinate" ;
		y:long_name = "y coordinate of projection" ;
		y:ioos_category = "Location" ;
		y:units = "m" ;
		y:axis = "Y" ;
		y:comment = "y values are the centers of the grid cells" ;
	int spatial_ref ;
		spatial_ref:grid_mapping_name = "polar_stereographic" ;
		spatial_ref:latitude_of_projection_origin = 90.0 ;
		spatial_ref:straight_vertical_longitude_from_pole = -45.0 ;
		spatial_ref:standard_parallel = 70.0 ;
		spatial_ref:false_easting = 0.0 ;
		spatial_ref:false_northing = 0.0 ;
		spatial_ref:semi_major_axis = 6378273.0 ;
		spatial_ref:inverse_flattening = 298.279411123061 ;
		spatial_ref:spatial_ref = "PROJCS[\"NSIDC Sea Ice Polar Stereographic North\",GEOGCS[\"Unspecified datum based upon the Hughes 1980 ellipsoid\",DATUM[\"Not_specified_based_on_Hughes_1980_ellipsoid\",SPHEROID[\"Hughes 1980\",6378273,298.279411123061]],PRIMEM[\"Greenwich\",0],UNIT[\"degree\",0.0174532925199433]],PROJECTION[\"Polar_Stereographic\"],PARAMETER[\"latitude_of_origin\",70],PARAMETER[\"central_meridian\",-45],PARAMETER[\"scale_factor\",1],PARAMETER[\"false_easting\",0],PARAMETER[\"false_northing\",0],UNIT[\"metre\",1]]" ;
		spatial_ref:crs = "PROJCS[\"NSIDC Sea Ice Polar Stereographic North\",GEOGCS[\"Unspecified datum based upon the Hughes 1980 ellipsoid\",DATUM[\"Not_specified_based_on_Hughes_1980_ellipsoid\",SPHEROID[\"Hughes 1980\",6378273,298.279411123061]],PRIMEM[\"Greenwich\",0],UNIT[\"degree\",0.0174532925199433]],PROJECTION[\"Polar_Stereographic\"],PARAMETER[\"latitude_of_origin\",70],PARAMETER[\"central_meridian\",-45],PARAMETER[\"scale_factor\",1],PARAMETER[\"false_easting\",0],PARAMETER[\"false_northing\",0],UNIT[\"metre\",1]]" ;
// global attributes:
		:Conventions = "CF-1.8, ACDD-1.3" ;
		:title = "SAR drift data converted from raw text form to NetCDF" ;
		:summary = "NetCDF version of the SAR Daily Drift dataset. This dataset includes the starting and ending coordinates (latitude and longitude), start and end observation dates, total distance traveled, and drift bearing over the observation period." ;
		:acknowledgement = "Produced by NOAA using IABP data." ;
		:creator_name = "Brendon Gory" ;
		:creator_email = "brendon.gory@noaa.gov" ;
		:creator_institution = "CIRA/NOAA" ;
		:creator_type = "Institution" ;
		:creator_url = "https://noaa.gov/" ;
		:publisher_name = "NOAA CoastWatch" ;
		:publisher_email = "coastwatch@noaa.gov" ;
		:publisher_institution = "NOAA CoastWatch" ;
		:publisher_type = "Institutional" ;
		:publisher_url = "https://coastwatch.noaa.gov/" ;
		:contributor_name = "NOAA PolarWatch, Southwest Fisheries Science Center, NESDIS STAR, U.S. National Ice Center" ;
		:contributor_role = "Producer, Publisher, Advisor, Originator" ;
		:processing_level = "NOAA Level 4" ;
		:product_version = "Version 1" ;
		:project = "NOAA Polarwatch" ;
		:source = "SAR Daily Drift dataset" ;
		:instrument = "See website for details" ;
		:platform = "Earth Observation Satellites, In Situ Land-based Platforms, Ground Stations, Models/Analyses" ;
		:platform_vocabulary = "NASA Global Change Master Directory (GCMD) Keywords, Version 9.0" ;
		:standard_name_vocabulary = "CF Standard Name Table (Version 72, 10 March 2020)" ;
		:keywords = "Earth Science > Cryosphere > Sea Ice > Ice Extent, Earth Science > Cryosphere > Snow/Ice > Snow Cover, GEOGRAPHIC REGION > ARCTIC, GEOGRAPHIC REGION > NORTHERN HEMISPHERE, GEOGRAPHIC REGION > POLAR" ;
		:keywords_vocabulary = "NASA Global Change Master Directory (GCMD) Keywords, Version 9.0" ;
		:license = "U.S. Government Work (public domain)" ;
		:history = "2025-04-02: First version of convert SAR daily drift to NetCDF" ;
		:references = "https://coastwatch.noaa.gov/cwn/products/sar-composite-arctic-imagery-normalized-radar-cross-section.html" ;
		:metadata_link = "https://coastwatch.noaa.gov/cwn/products/sar-composite-arctic-imagery-normalized-radar-cross-section.html" ;
		:sourceUrl = "https://www.star.nesdis.noaa.gov/socd/mecb/sar/AKDEMO_products/COMPOSITE_TIFF/DRIFT_SHAPEFILES/" ;
		:naming_authority = "gov.noaa.polarwatch" ;
		:ncei_template_version = "NCEI_NetCDF_Grid_Template_v2.0" ;
		:date_created = "FILL_DATE_CREATED" ;
		:time_coverage_start = "FILL_MIN_TIME" ;
		:time_coverage_end = "FILL_MAX_TIME" ;
		:time_coverage_duration = "P1D" ;
		:time_coverage_resolution = "P1D" ;
}